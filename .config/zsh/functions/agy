#!/usr/bin/env zsh

# agy - Run agy with --project $GCP_PROJECT unless --project is passed explicitly
# GCP_PROJECT is set in ~/.env. Help and version flags pass through unchanged.
if (($# == 1)) && [[ "$1" == "-h" || "$1" == "--help" || "$1" == "-v" || "$1" == "--version" ]]; then
    command agy "$@"
    return
fi

local arg
for arg in "$@"; do
    if [[ "$arg" == "--project" || "$arg" == --project=* ]]; then
        command agy "$@"
        return
    fi
done

if [[ -z "${GCP_PROJECT:-}" ]]; then
    print -u2 "agy: GCP_PROJECT is not set and --project was not given"
    return 1
fi
command agy --project "$GCP_PROJECT" "$@"
