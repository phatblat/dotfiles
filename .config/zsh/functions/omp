#!/usr/bin/env zsh

# omp - Launch OMP with home-directory sessions allowed. Profile selection is
# env-based: omp reads OMP_PROFILE itself (set in ~/.env), and an explicit
# profile flag on the command line overrides that variable.
local arg
for arg in "$@"; do
    if [[ $arg == --allow-home ]]; then
        command omp "$@"
        return
    fi
done

command omp --allow-home "$@"
