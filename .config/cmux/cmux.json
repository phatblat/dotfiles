{
  "$schema": "https://raw.githubusercontent.com/manaflow-ai/cmux/main/web/data/cmux.schema.json",
  "schemaVersion": 1,
  "shortcuts": {
    "bindings": {
      "showHideAllWindows": "ctrl+`",
      "toggleFileExplorer": "cmd+;",
      "markWorkspaceDone": "none",
    },
  },
  "terminal": {
    "autoResumeAgentSessions": true,
    "agentHibernation": {
      "maxLiveTerminals": 8,
    },
  },
  "app": {
    "appearance": "system",
    "commandPaletteSearchesAllSurfaces": true,
    "confirmQuit": "never",
    "equalizeSplitsOnCreate": true,
    "focusPaneOnFirstClick": true,
    "hideTabCloseButton": false,
    "menuBarOnly": false,
    "minimalMode": true,
    "preferredEditor": "zed",
    "reorderOnNotification": false,
    "warnBeforeClosingTab": false,
  },
  "fileEditor": {
    "wordWrap": true,
  },
  "notifications": {
    "paneFlashThemeColor": true,
    "showInMenuBar": true,
    "sound": "Purr",
  },
  "workspaceColors": {
    "notificationBadgeColor": "#00FC00",
    "selectionColor": "#6A00FF",
  },
}
