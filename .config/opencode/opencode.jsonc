{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": "notify",
  "instructions": [
    "~/.agents/harness/instructions.md"
  ],
  "model": "openrouter/anthropic/claude-sonnet-4.6",
  "permission": {
    "bash": {
      "*": "ask",
      "find *": "allow",
      "find * -delete*": "ask",
      "find * -exec*": "ask",
      "find * -fls*": "ask",
      "find * -fprint*": "ask",
      "find * -ok*": "ask",
      "git diff*": "allow",
      "git log*": "allow",
      "git show*": "allow",
      "git status*": "allow",
      "just harness-check": "allow",
      "ls *": "allow",
      "rg *": "allow",
      "rm *": "ask",
      "sudo *": "deny"
    },
    "edit": "ask",
    "external_directory": "ask",
    "webfetch": "ask"
  },
  "share": "manual",
  "small_model": "openrouter/anthropic/claude-haiku-4.5"
}
