#!/usr/bin/env bash
#
# pre-commit hook — lint shell scripts before committing
#
# Runs shellcheck on zsh functions and bin scripts.
# Requires: shellcheck (managed by mise)
#

set -e

# Collect staged files into NUL-delimited temp files for safe iteration
zsh_list=$(mktemp)
bin_list=$(mktemp)
trap 'rm -f "$zsh_list" "$bin_list"' EXIT
# Guard: never commit a leaked test identity in the tracked git config.
# The quickstart publish test suite writes "Test Suite <test-suite@example.com>"
# via `git config --global`; if its HOME isolation is bypassed (XDG_CONFIG_HOME),
# that lands in ~/.config/git/config and would be committed here.
for cfg in .config/git/config .gitconfig; do
    git diff --cached --name-only -- "$cfg" | grep -q . || continue
    if git show ":$cfg" | grep -qE 'Test Suite|test-suite@example\.com'; then
        echo "pre-commit: $cfg contains the test identity (Test Suite / test-suite@example.com)" >&2
        echo "pre-commit: strip those lines or run: git checkout -- $cfg" >&2
        exit 1
    fi
done

# Normalize the mise config before it can be committed. `mise upgrade`/`mise
# use` append/rewrite entries without preserving the alphabetical [tools]
# order that `just lint-mise` enforces in CI, and that drift is invisible
# locally unless HOME happens to point at this checkout (see PR #449).
if git diff --cached --name-only -- .config/mise/config.toml | grep -q .; then
    if ! command -v mise >/dev/null 2>&1; then
        echo "pre-commit: mise not found — install with: https://mise.run" >&2
        exit 1
    fi
    repo_root=$(git rev-parse --show-toplevel)
    echo "pre-commit: formatting .config/mise/config.toml..."
    HOME="$repo_root" mise fmt
    HOME="$repo_root" python3 "$repo_root/scripts/sort-tools.py"
    git add .config/mise/config.toml
fi

git diff --cached --name-only -z --diff-filter=ACM | while IFS= read -r -d '' file; do
    case "$file" in
        .config/zsh/functions/*) printf '%s\0' "$file" >> "$zsh_list" ;;
        bin/*.sh)                printf '%s\0' "$file" >> "$bin_list" ;;
    esac
done

# Exit early if no relevant files staged
if [ ! -s "$zsh_list" ] && [ ! -s "$bin_list" ]; then
    exit 0
fi

# Ensure shellcheck is available
if ! command -v shellcheck >/dev/null 2>&1; then
    echo "pre-commit: shellcheck not found — install with: mise install shellcheck"
    exit 1
fi

errors=0

if [ -s "$zsh_list" ]; then
    echo "pre-commit: linting zsh functions..."
    # shellcheck: ksh dialect for zsh, exclude SC2168 (local in autoload)
    xargs -0 -I{} shellcheck -s ksh -e SC2168 {} < "$zsh_list" || errors=1
fi

if [ -s "$bin_list" ]; then
    echo "pre-commit: linting bin scripts..."
    xargs -0 -I{} shellcheck {} < "$bin_list" || errors=1
fi

if [ "$errors" -ne 0 ]; then
    echo "pre-commit: lint failed, commit aborted"
    exit 1
fi
