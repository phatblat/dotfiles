// -*- mode: jsonc -*-
{
  "markdown_preview_code_font_family": "JetBrainsMono Nerd Font",
  "markdown_preview_font_family": "JetBrainsMono Nerd Font",
  "markdown_preview_font_size": 18.0,
  "cli_default_open_behavior": "existing_window",
  "bottom_dock_layout": "contained",
  "use_system_window_tabs": true,
  "tabs": {
    "close_position": "right",
    "git_status": true,
    "file_icons": true,
  },
  "status_bar": {
    "show_active_file": false,
  },
  "title_bar": {
    "show_menus": true,
    "show_branch_status_icon": true,
  },
  "project_panel": {
    "dock": "left",
    "indent_size": 16,
  },
  "outline_panel": {
    "dock": "right",
  },
  "collaboration_panel": {
    "dock": "right",
  },
  "git_panel": {
    "dock": "right",
  },
  "agent": {
    "sidebar_side": "right",
    "dock": "left",
    "default_model": {
      "model": "claude-3-5-haiku-latest",
      "provider": "anthropic",
    },
    "default_profile": "write",
    "inline_assistant_model": {
      "model": "qwen/qwen3-coder-30b",
      "provider": "lmstudio",
    },
    "message_editor_min_lines": 5,
    "play_sound_when_agent_done": "always",
    "show_turn_stats": true,
    "single_file_review": true,
    "tool_permissions": {
      "default": "allow",
    },
  },
  "agent_servers": {
    "grok-build": {
      "type": "registry",
    },
    "antigravity-acp": {
      "type": "registry",
    },
    "gemini": {
      "type": "registry",
    },
    "cursor": {
      "type": "registry",
    },
    "codex-acp": {
      "type": "registry",
    },
    "pi-acp": {
      "type": "registry",
    },
    "opencode": {
      "type": "registry",
    },
    "claude-acp": {
      "default_mode": "acceptEdits",
      "type": "registry",
    },
    "omp": {
      "type": "custom",
      "command": "omp",
      "args": ["--mode", "acp"],
      "env": {},
    },
  },
  "auto_update": true,
  "autosave": "on_focus_change",
  "buffer_font_family": ".ZedMono",
  "buffer_font_size": 16,
  "file_finder": {
    "include_ignored": "smart",
  },
  "file_types": {
    "Dockerfile": ["*.Dockerfile"],
    "Shell Script": [".config/zsh/functions/*", "*.zsh"],
  },
  "format_on_save": "on",
  "hard_tabs": false,
  "icon_theme": {
    "mode": "light",
    "light": "Zed (Default)",
    "dark": "Zed (Default)",
  },
  "languages": {
    "Markdown": {
      "soft_wrap": "editor_width",
      "remove_trailing_whitespace_on_save": false,
    },
    "Shell Script": {
      "preferred_line_length": 120,
    },
  },
  "markdown_preview": {
    "limit_content_width": false,
  },
  "lsp": {
    "rust-analyzer": {
      "initialization_options": {
        "analyzerTargetDir": true,
      },
    },
  },
  "redact_private_values": false,
  "relative_line_numbers": "disabled",
  "search": {
    "include_ignored": false,
  },
  "show_whitespaces": "all",
  "ssh_connections": [
    {
      "host": "phatstudio.local",
      "username": "phatblat",
      "args": [],
      "projects": [
        {
          "paths": ["/Users/phatblat"],
        },
      ],
    },
  ],
  "tab_bar": {
    "show": true,
    "show_nav_history_buttons": false,
  },
  "tab_size": 2,
  "terminal": {
    "keep_selection_on_copy": false,
  },
  "theme": {
    "mode": "system",
    "light": "Ayu Light",
    "dark": "Ayu Dark",
  },
  "ui_font_size": 16,
}
