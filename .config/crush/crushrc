# Generated by scripts/agent-harnesses.py; do not edit directly.

# Shared harness instructions, loaded for every session.
option global-context-path "$HOME/.config/crush/shared-harness.md"

# Shared skills. Crush's default *global* skill roots are
# ~/.config/crush/skills and ~/.config/agents/skills, so the shared root has
# to be named explicitly; only the project-relative .agents/skills is implicit.
option skill-path "$HOME/.agents/skills"

# The generated context file above carries the commit trailer. Keep crush from
# appending a second one of its own.
option attribution-trailer-style none
option attribution-generated-with false

# Normalized safety guard. Crush resolves a hook command against the process
# working directory rather than the config file, so a global hook needs an
# absolute path; python3 is invoked explicitly so the hook does not depend on
# the generated file carrying an exec bit.
hook add PreToolUse \
  --name shared-harness-guard \
  --matcher "^(bash|edit|write|multiedit|download)$" \
  --command "python3 $HOME/.config/crush/hooks/harness-guard.py" \
  --timeout 10
