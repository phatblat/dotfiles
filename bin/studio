#!/bin/bash
#Generated by JetBrains Toolbox 2.1.1.18388 at 2023-12-08T11:23:37.066091

declare -a intellij_args=()
declare -- wait=""

for o in "$@"; do
  if [[ "$o" = "--wait" || "$o" = "-w" ]]; then
    wait="-W"
    o="--wait"
  fi
  if [[ "$o" =~ " " ]]; then
    intellij_args+=("\"$o\"")
  else
    intellij_args+=("$o")
  fi
done

open -na "/Users/phatblat/Applications/Android Studio Iguana 2023.2.1 Canary 17.app/Contents/MacOS/studio" $wait --args "${intellij_args[@]}"