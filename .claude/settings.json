{
  "agentPushNotifEnabled": true,
  "effortLevel": "xhigh",
  "enabledPlugins": {
    "clangd-lsp@claude-plugins-official": false,
    "claude-code-setup@claude-plugins-official": false,
    "claude-hud@claude-hud": true,
    "claude-md-management@claude-plugins-official": false,
    "code-review@claude-plugins-official": true,
    "code-simplifier@claude-plugins-official": false,
    "context-mode@context-mode": true,
    "csharp-lsp@claude-plugins-official": false,
    "gopls-lsp@claude-plugins-official": true,
    "hookify@claude-plugins-official": true,
    "jdtls-lsp@claude-plugins-official": false,
    "kotlin-lsp@claude-plugins-official": true,
    "linear-cli@linear-cli": true,
    "linear@claude-plugins-official": false,
    "lua-lsp@claude-plugins-official": true,
    "oh-my-claudecode@omc": true,
    "plugin-dev@claude-plugins-official": false,
    "pup@datadog-pup": false,
    "pyright-lsp@claude-plugins-official": true,
    "ralph-loop@claude-plugins-official": false,
    "ruby-lsp@claude-plugins-official": false,
    "rust-analyzer-lsp@claude-plugins-official": true,
    "security-guidance@claude-plugins-official": false,
    "skill-creator@claude-plugins-official": false,
    "superpowers@claude-plugins-official": false,
    "swift-lsp@claude-plugins-official": true,
    "typescript-lsp@claude-plugins-official": true,
    "warp@claude-code-warp": true
  },
  "env": {
    "BASH_DEFAULT_TIMEOUT_MS": "90000",
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1",
    "MAX_MCP_OUTPUT_TOKENS": "12000"
  },
  "extraKnownMarketplaces": {
    "claude-code-warp": {
      "source": {
        "repo": "warpdotdev/claude-code-warp",
        "source": "github"
      }
    },
    "claude-hud": {
      "source": {
        "repo": "jarrodwatts/claude-hud",
        "source": "github"
      }
    },
    "context-mode": {
      "source": {
        "repo": "mksglu/context-mode",
        "source": "github"
      }
    },
    "datadog-pup": {
      "source": {
        "repo": "DataDog/pup",
        "source": "github"
      }
    },
    "linear-cli": {
      "source": {
        "repo": "schpet/linear-cli",
        "source": "github"
      }
    },
    "omc": {
      "source": {
        "source": "git",
        "url": "https://github.com/Yeachan-Heo/oh-my-claudecode.git"
      }
    }
  },
  "hooks": {
    "Notification": [
      {
        "hooks": [
          {
            "command": "bash ~/.claude/agent-flow/agent-flow-guard.sh",
            "timeout": 4,
            "type": "command"
          }
        ]
      },
      {
        "hooks": [
          {
            "command": "if [ -n \"$PASEO_TERMINAL_ID\" ]; then \"${PASEO_HOOK_CLI:-paseo}\" hooks claude Notification; fi",
            "timeout": 10,
            "type": "command"
          }
        ],
        "matcher": ""
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "command": "bash ~/.claude/hooks/scripts/auto-format.sh",
            "timeout": 30,
            "type": "command"
          }
        ],
        "matcher": "Write|Edit"
      },
      {
        "hooks": [
          {
            "command": "bash ~/.claude/agent-flow/agent-flow-guard.sh",
            "timeout": 4,
            "type": "command"
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "hooks": [
          {
            "command": "bash ~/.claude/hooks/scripts/posttooluse-failure.sh",
            "timeout": 3,
            "type": "command"
          }
        ]
      },
      {
        "hooks": [
          {
            "command": "bash ~/.claude/agent-flow/agent-flow-guard.sh",
            "timeout": 4,
            "type": "command"
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "command": "bash ~/.claude/hooks/scripts/pre-compact.sh",
            "timeout": 5,
            "type": "command"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "command": "bash ~/.claude/hooks/scripts/write-guard.sh",
            "timeout": 3,
            "type": "command"
          }
        ],
        "matcher": "Write|Edit"
      },
      {
        "hooks": [
          {
            "command": "bash ~/.claude/hooks/scripts/bash-guard.sh",
            "timeout": 3,
            "type": "command"
          }
        ],
        "matcher": "Bash"
      },
      {
        "hooks": [
          {
            "command": "rtk hook claude",
            "timeout": 10,
            "type": "command"
          }
        ],
        "matcher": "Bash"
      },
      {
        "hooks": [
          {
            "command": "bash ~/.claude/hooks/scripts/pre-commit-format.sh",
            "if": "Bash(git commit*)",
            "timeout": 60,
            "type": "command"
          }
        ],
        "matcher": "Bash"
      },
      {
        "hooks": [
          {
            "command": "bash ~/.claude/agent-flow/agent-flow-guard.sh",
            "timeout": 4,
            "type": "command"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "command": "bash ~/.claude/hooks/scripts/session-end.sh",
            "timeout": 3,
            "type": "command"
          }
        ]
      },
      {
        "hooks": [
          {
            "command": "bash ~/.claude/agent-flow/agent-flow-guard.sh",
            "timeout": 4,
            "type": "command"
          }
        ]
      },
      {
        "hooks": [
          {
            "command": "if [ -n \"$PASEO_TERMINAL_ID\" ]; then \"${PASEO_HOOK_CLI:-paseo}\" hooks claude SessionEnd; fi",
            "timeout": 10,
            "type": "command"
          }
        ],
        "matcher": ""
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "bash ~/.claude/agent-flow/agent-flow-guard.sh",
            "timeout": 4,
            "type": "command"
          }
        ]
      },
      {
        "hooks": [
          {
            "command": "bun ${CLAUDE_CONFIG_DIR:-$HOME/.claude}/hooks/context-mode-cache-heal.mjs",
            "timeout": 5,
            "type": "command"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "command": "bash ~/.claude/agent-flow/agent-flow-guard.sh",
            "timeout": 4,
            "type": "command"
          }
        ]
      },
      {
        "hooks": [
          {
            "command": "if [ -n \"$PASEO_TERMINAL_ID\" ]; then \"${PASEO_HOOK_CLI:-paseo}\" hooks claude Stop; fi",
            "timeout": 10,
            "type": "command"
          }
        ],
        "matcher": ""
      }
    ],
    "StopFailure": [
      {
        "hooks": [
          {
            "command": "if [ -n \"$PASEO_TERMINAL_ID\" ]; then \"${PASEO_HOOK_CLI:-paseo}\" hooks claude StopFailure; fi",
            "timeout": 10,
            "type": "command"
          }
        ],
        "matcher": ""
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "command": "bash ~/.claude/agent-flow/agent-flow-guard.sh",
            "timeout": 4,
            "type": "command"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "command": "bash ~/.claude/agent-flow/agent-flow-guard.sh",
            "timeout": 4,
            "type": "command"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "command": "bash ~/.claude/hooks/scripts/user-prompt-secrets.sh",
            "timeout": 2,
            "type": "command"
          }
        ]
      },
      {
        "hooks": [
          {
            "command": "if [ -n \"$PASEO_TERMINAL_ID\" ]; then \"${PASEO_HOOK_CLI:-paseo}\" hooks claude UserPromptSubmit; fi",
            "timeout": 10,
            "type": "command"
          }
        ],
        "matcher": ""
      }
    ]
  },
  "model": "sonnet",
  "omcHud": {
    "elements": {
      "showTokens": true
    }
  },
  "permissions": {
    "allow": [
      "mcp__acp__Edit",
      "mcp__acp__Bash",
      "mcp__acp__Write",
      "WebSearch",
      "WebFetch(domain:github.com)",
      "WebFetch(domain:docs.basedpyright.com)",
      "Bash(claude mcp list)",
      "Bash(git status *)",
      "Bash(git branch *)",
      "Bash(git log *)",
      "Bash(git diff *)",
      "Bash(git fetch *)",
      "Bash(git checkout *)",
      "Bash(git check-ignore *)",
      "Bash(git switch *)",
      "Bash(git rev-list *)",
      "Bash(git ls-remote *)",
      "Bash(git rev-parse *)",
      "Bash(git show *)",
      "Bash(git remote *)",
      "Bash(git symbolic-ref *)",
      "Bash(git merge --ff-only *)",
      "Bash(git add *)",
      "Bash(git push *)",
      "Bash(git commit *)",
      "Bash(git pull *)",
      "Bash(git stash *)",
      "Bash(git worktree *)",
      "Bash(git rebase *)",
      "Bash(git tag *)",
      "Bash(gh pr list *)",
      "Bash(gh pr create *)",
      "Bash(gh pr view *)",
      "Bash(gh pr edit *)",
      "Bash(gh api *)",
      "Bash(gh run *)",
      "Bash(gh search *)",
      "Bash(gh issue *)",
      "Bash(linear *)",
      "Bash(sg *)",
      "Bash(just *)",
      "Bash(mise ls *)",
      "Bash(mise search *)",
      "Bash(mise use *)",
      "Bash(mise install *)",
      "Bash(mise current *)",
      "Bash(mise self-update *)",
      "Bash(mise upgrade *)",
      "Bash(brew update*)",
      "Bash(brew outdated*)",
      "Bash(brew upgrade*)",
      "Bash(uv tool upgrade*)",
      "Bash(rtk *)",
      "Bash(ctx7 *)",
      "Bash(date *)",
      "Bash(echo *)",
      "Bash(timeout *)",
      "Bash(wc *)",
      "Bash(find *)",
      "Bash(xargs *)",
      "Bash(ls *)",
      "Bash(ps *)",
      "Bash(python3 *)",
      "Bash(jq *)",
      "Bash(sort *)",
      "Bash(uniq *)",
      "Bash(tr *)",
      "Bash(cut *)",
      "Bash(basename *)",
      "Bash(dirname *)",
      "Bash(grep *)",
      "Bash(rg *)",
      "Bash(head *)",
      "Bash(tail *)",
      "Bash(tee *)",
      "Bash(file *)",
      "Bash(stat *)",
      "Bash(cargo check*)",
      "Bash(cargo clippy*)",
      "Bash(cargo fmt*)",
      "Bash(cargo test*)",
      "Bash(go build*)",
      "Bash(go test*)",
      "Bash(go vet*)",
      "Bash(npm run*)",
      "Bash(npm test*)",
      "Bash(npx tsc*)",
      "Bash(cat *)",
      "Bash(awk *)",
      "Bash(printf *)",
      "Bash(seq *)",
      "Bash(tree *)",
      "Bash(diff *)",
      "Bash(cmp *)",
      "Bash(du *)",
      "Bash(which *)",
      "Bash(command -v *)",
      "Bash(readlink *)",
      "Bash(realpath *)",
      "Bash(printenv *)",
      "Bash(env)",
      "Bash(pwd)",
      "Bash(true)",
      "Bash(test *)",
      "Bash([ *)",
      "Bash(sleep *)",
      "Bash(sed *)",
      "Bash(shfmt *)",
      "Bash(shellcheck *)",
      "Bash(ruff *)",
      "Bash(prettier *)",
      "Bash(typos *)",
      "Bash(yamllint *)"
    ],
    "defaultMode": "auto",
    "deny": []
  },
  "remoteControlAtStartup": false,
  "skipAutoPermissionPrompt": true,
  "skipDangerousModePermissionPrompt": true,
  "statusLine": {
    "command": "bun ${CLAUDE_CONFIG_DIR:-$HOME/.claude}/hud/omc-hud.mjs",
    "type": "command"
  },
  "teammateMode": "in-process",
  "theme": "auto",
  "tui": "fullscreen",
  "worktree": {
    "baseRef": "fresh"
  }
}
