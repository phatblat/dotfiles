{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "enableAllProjectMcpServers": true,
  "enabledPlugins": {
    "clangd-lsp@claude-plugins-official": false,
    "claude-code-setup@claude-plugins-official": false,
    "claude-md-management@claude-plugins-official": false,
    "gopls-lsp@claude-plugins-official": false,
    "lua-lsp@claude-plugins-official": false,
    "pyright-lsp@claude-plugins-official": false,
    "rust-analyzer-lsp@claude-plugins-official": false,
    "skill-creator@claude-plugins-official": false,
    "swift-lsp@claude-plugins-official": false,
    "typescript-lsp@claude-plugins-official": false
  },
  "outputStyle": "Sr. Software Developer",
  "permissions": {
    "allow": [
      "Bash(sed:*)",
      "Bash(find:*)",
      "Bash(/bin/ls:*)",
      "Bash(wc:*)",
      "Bash(tree:*)",
      "Bash(brew --prefix:*)",
      "Bash(/nix/var/nix/profiles/default/bin/cachix use:*)",
      "Bash(~/.nix-profile/bin/cachix use nix-community)",
      "Bash(claude --version:*)",
      "Bash(nix:*)",
      "Bash(npm view:*)",
      "Bash(nix-prefetch-url:*)",
      "Bash(tar:*)",
      "Bash(shasum:*)",
      "Bash(/nix/var/nix/profiles/default/bin/nix:*)",
      "Bash(/nix/var/nix/profiles/default/bin/nix-build:*)",
      "Bash(/nix/var/nix/profiles/default/bin/nix-env:*)",
      "Bash(~/.nix-profile/bin/claude:*)",
      "Bash(cat:*)",
      "Bash(test:*)",
      "Bash(source ~/.bashrc)",
      "Bash(ccr --help:*)",
      "Bash(ccr status:*)",
      "Bash(ccr start:*)",
      "Bash(npm info:*)",
      "Bash(ccr restart:*)",
      "Bash(command -v:*)",
      "Bash(bats:*)",
      "Bash(gh pr:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(~/.local/bin/mise plugins:*)",
      "Bash(~/.local/bin/mise uninstall:*)",
      "Bash(~/.local/bin/mise install:*)",
      "Bash(~/.local/bin/mise reshim:*)",
      "Bash(~/.local/bin/mise doctor:*)",
      "Bash(~/.local/bin/mise settings:*)",
      "Bash(~/.local/bin/mise --version)",
      "Bash(~/.local/bin/mise activate:*)",
      "Bash(~/.local/bin/mise ls:*)",
      "Bash(MISE_NODE_MODULES_DIR=0 ~/.local/bin/mise activate zsh)",
      "Bash(~/.local/bin/mise hook-env:*)",
      "Bash(MISE_NODE_MODULES_BIN=0 ~/.local/bin/mise hook-env)",
      "Bash(~/.local/bin/mise env:*)",
      "Bash(git -C ~ ls-files)",
      "Bash(git -C ~ config --get rerere.enabled)",
      "Bash(gh --version)",
      "Bash(gh auth *)",
      "Bash(ruby --version)",
      "Bash(bd --version)",
      "Bash(br --version)",
      "Bash(npm --version)",
      "Bash(systemextensionsctl list *)",
      "Skill(git:commit)",
      "Bash(GIT_EDITOR=true git rebase --continue)",
      "Bash(npm -g config get prefix)",
      "WebFetch(domain:downloads.claude.ai)",
      "Skill(brainstorm)",
      "WebSearch",
      "Skill(claude-api)",
      "Bash(env)"
    ],
    "deny": []
  },
  "spinnerTipsEnabled": false
}
