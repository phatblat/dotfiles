#!/usr/bin/env bash

# GitHub
export GITHUB_TOKEN=
export GITHUB_PERSONAL_ACCESS_TOKEN="${GITHUB_TOKEN}"
export MISE_GITHUB_TOKEN="${GITHUB_TOKEN}"
# Used by the github-pat-refresh function
export GITHUB_PAT_ID=

# OMP profile for review-pr.py and cmt on this machine (e.g. casper)
export REVIEW_PR_OMP_PROFILE=
