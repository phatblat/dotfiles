{
  "altScreenMode": "always",
  "colorScheme": "colorblind-friendly dark",
  "enableTelemetry": false,
  "enableTerminalSandbox": true,
  "model": "Gemini 3.6 Flash (High)",
  "permissions": {
    "allow": [
      "unsandboxed(git status)",
      "unsandboxed(just lint)",
      "unsandboxed(git add)",
      "unsandboxed(git diff)",
      "unsandboxed(git commit)",
      "unsandboxed(git check-ignore)",
      "unsandboxed(git show)",
      "unsandboxed(~/scripts/sort-gitignore)",
      "unsandboxed(mv)"
    ]
  },
  "showFeedbackSurvey": false,
  "statusLine": {
    "command": "",
    "enabled": true,
    "type": ""
  },
  "toolPermission": "proceed-in-sandbox"
}
