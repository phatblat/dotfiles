# Codex rewrites machine-managed state (marketplace timestamps/revisions, hook
# trust hashes) into these files on nearly every launch. The `codex-config` clean
# filter normalizes that churn out of the committed blob so they stay stable
# across launches and machines. Install the filter with `just git-filters`
# (it is local git config, not carried by these attributes alone).
# Filter script: ~/scripts/mask-codex-state.sh
.codex/config.toml filter=codex-config
.codex/*.config.toml filter=codex-config

# `oc login` writes a live OpenComputer API key into ~/.oc/config.json
# alongside non-secret metadata. The `oc-config` clean filter strips the
# api_key field from the committed blob so the secret never enters git
# history; the on-disk file oc reads is never touched. Install the filter
# with `just git-filters`. Filter script: ~/scripts/mask-oc-config.sh
.oc/config.json filter=oc-config

# Pi rewrites cache-validator fields (checkedAt, etag, lastModified) into every
# provider object in ~/.pi/agent/models-store.json on nearly every model-list
# refresh. The `pi-models-store` clean filter normalizes those three fields out
# of the committed blob so real model data stays stable across refreshes and
# machines. Install the filter with `just git-filters`.
# Filter script: ~/scripts/mask-pi-models-store.sh
.pi/agent/models-store.json filter=pi-models-store
