{
  "theme_light": "dark-neon-noir",
  "copy_on_select": true,
  "cursor": {
    "glide": 40
  },
  "link_click": "Command",
  "link_target": "Browser",
  "layout": "Rail",
  "font_size": 18,
  "tabs": "Vertical",
  "status_bar": true,
  "surface_diffs": "Split",
  "surface_tab_width": 2,
  "expand_thoughts": true,
  "composer_text": "Markdown",
  "shell": "/Users/phatblat/bin/nu-login",
  "prompt_style": "tokyonight",
  "prompt_parts": {
    "palette": "dracula",
    "collapse": false
  },
  "agent_placement": "replace_if_alone",
  "prefs_width": 589,
  "files": {
    "auto_save": {
      "after_delay": 1000
    }
  },
  "file_tree": {
    "width": 544,
    "preview_click": true
  },
  "git": {
    "use_local_ssh_agent": false,
    "external_editor": "/opt/homebrew/bin/zed --wait",
    "show_commit_author": true
  },
  "sqlite": {
    "location_dir": "/Users/phatblat/dev",
    "browse_font_size": 12,
    "image_preview": true,
    "indent_compact": true
  },
  "agents": {
    "auto_acp": true
  },
  "keybinds": {
    "cmd+b": [
      "git.new_branch",
      "markdown.bold",
      "sqlite.browse.bold"
    ],
    "ctrl+cmd+s": "toggle_sidebar",
    "ctrl+shift+k": "switch_session",
    "ctrl+shift+l": "lock_session",
    "ctrl+shift+n": "new_session",
    "ctrl+shift+r": "rename_session",
    "ctrl+shift+w": "close_session",
    "shift+cmd+[": "previous_tab_across_sessions",
    "shift+cmd+]": "next_tab_across_sessions"
  },
  "secure_keyboard_entry": true
}