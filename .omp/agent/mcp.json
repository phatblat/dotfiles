{
  "mcpServers": {
    "context-mode": {
      "args": [
        "${HOME}/${PI_CONFIG_DIR:-.omp}/plugins/node_modules/context-mode/server.bundle.mjs"
      ],
      "command": "bun",
      "type": "stdio"
    },
    "google-calendar": {
      "args": [
        "-y",
        "@cocal/google-calendar-mcp"
      ],
      "command": "npx",
      "env": {
        "GOOGLE_OAUTH_CREDENTIALS": "${HOME}/.config/google-calendar-mcp/gcp-oauth.keys.json"
      },
      "type": "stdio"
    }
  }
}
