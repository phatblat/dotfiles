home = "/Users/phatblat"

# Node scripts bundled with Codex skills
prefix_rule(pattern=["node", home + "/.codex/skills/.system/openai-docs/scripts/fetch-codex-manual.mjs"], decision="allow")

# Read-only git introspection (used in compound status checks)
prefix_rule(pattern=["git", "status"], decision="allow")
prefix_rule(pattern=["git", "log"], decision="allow")
prefix_rule(pattern=["git", "diff"], decision="allow")

# Nested agents and test runs leave the sandbox, so each one asks first.
prefix_rule(pattern=["codex", "exec"], decision="prompt")
prefix_rule(pattern=["cargo", "test"], decision="prompt")
prefix_rule(pattern=["/bin/zsh", "-lc", "RUSTC_WRAPPER= cargo test --workspace"], decision="prompt")
prefix_rule(pattern=["log", "show"], decision="allow")
prefix_rule(pattern=["pgrep"], decision="allow")
